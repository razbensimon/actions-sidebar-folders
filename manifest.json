{
  "manifest_version": 3,
  "name": "Actions Sidebar Folders",
  "version": "1.0.0",
  "description": "Nest GitHub Actions sidebar workflows by slash-separated name prefixes, with controls for disabled workflows.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Actions Sidebar Folders",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/actions*"],
      "js": [
        "content/settings.js",
        "content/tree.js",
        "content/disabled.js",
        "content/fetch.js",
        "content/render.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/razbensimon/actions-sidebar-folders"
}
